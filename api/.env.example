# PostgreSQL de Railway (te lo da al crear el servicio Postgres)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# Puerto del API
PORT=4000

# CORS: URL del front en Cloudflare (y localhost en dev)
CORS_ORIGIN=http://localhost:3000

# Auth admin
JWT_SECRET=cambiá-esto-por-un-secreto-largo
ADMIN_EMAIL=admin@beautymax.uy
ADMIN_PASSWORD=BeautymaxAdmin2026!

# Mercado Pago (opcional)
ENABLE_MP=false
MP_ACCESS_TOKEN=
SITE_URL=https://beautymax-web.pages.dev

# URL pública del API (para armar links de /media al sincronizar imágenes EM)
PUBLIC_API_URL=http://localhost:4000

# Easy Management / HYC (API V297)
# Pedí a HYC la URL base real y el token de tu cuenta.
EM_ENABLED=false
EM_BASE_URL=
EM_TOKEN=
EM_TOKEN_HEADER=Authorization
EM_LISTA_PRECIO=VENTA
EM_DEPOSITO=
EM_SOLO_WEB=false
EM_TIPO_DOC_PEDIDO=
EM_TERMINAL=A
EM_USUARIO=web
EM_MONEDA=1
EM_TIPO_CAMBIO=1
EM_AUTO_PUSH_ORDERS=true
EM_DEFAULT_CATEGORY=styling
EM_DEFAULT_BRAND=Beautymax
EM_DEFAULT_IMPUESTO_CODIGO=2
EM_DEFAULT_IMPUESTO_TASA=22
EM_GUEST_AS_GENERIC=false
